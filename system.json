        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "system": "outside-the-wire"
    },
    {
      "name": "quickstart",
      "label": "Quickstart",
      "path": "packs/quickstart",
      "type": "Adventure",
      "ownership": {
        "ASSISTANT": "OWNER"
      },
      "system": "outside-the-wire"
    }
  ],
  "packFolders": [
    {
      "name": "Outside the Wire",
      "sorting": "m",
      "color": "#7b620a",
      "packs": [
        "quickstart"
      ]
    }
  ],
  "socket": false,
  "manifest": "https://github.com/hodpub/outside-the-wire/releases/latest/download/system.json",
  "download": "https://github.com/hodpub/outside-the-wire/releases/latest/download/system.zip",
  "background": "systems/outside-the-wire/assets/outside-the-wire.webp",
  "grid": {
    "type": 1,
    "distance": 1,
    "units": "m",
    "diagonals": 0
