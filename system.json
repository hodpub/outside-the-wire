        "htmlFields": [
          "description"
        ]
      },
      "background": {
        "htmlFields": [
          "description"
        ]
      },
      "equipment": {
        "htmlFields": [
          "description"
        ]
      },
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "explosive": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
