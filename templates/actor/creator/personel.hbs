<section class='tab personel scrollable {{tab.cssClass}}' data-group='primary' data-tab='personel'>
  <h1>{{localize "OUTSIDE_THE_WIRE.Actor.Tabs.Personal"}}</h1>

  <div class="form-group"><label>Nickname</label>
    <div class="form-fields"><input type="text" value="{{actor.nickname}}" name="nickname"></div>
  </div>
  <div class="form-group"><label>Age</label>
    <div class="form-fields"><input type="number" value="{{actor.age.value}}" step="1" name="age.value"></div>
  </div>
  <div class="form-group"><label>Nationality</label>
    <div class="form-fields">
      <select name="nationality">
        {{selectOptions @root.config.ACTOR.NATIONALITY selected=actor.nationality}}
      </select>
    </div>
  </div>
  <div class="form-group"><label>Height</label>
    <div class="form-fields"><input type="text" value="" name="height"></div>
  </div>
  <div class="form-group"><label>Weight</label>
    <div class="form-fields"><input type="text" value="" name="weight"></div>
  </div>
  <div class="form-group"><label>Service Branch</label>
    <div class="form-fields">
      <select name="serviceBranch">
        {{selectOptions @root.config.ACTOR.SERVICE_BRANCHE_CHOICES selected=actor.serviceBranch localize=true}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>Motivation</label>
    <div class="form-fields up-down-buttons">
      <input type="text" value="{{actor.motivation}}" name="motivation">
      <button type="button" data-action="rollMotivation"><i class="fa-solid fa-dice"></i></button>
    </div>
  </div>
  <div class="form-group">
    <label>Trademark</label>
    <div class="form-fields up-down-buttons">
      <input type="text" value="{{actor.trademark}}" name="trademark">
      <button type="button" data-action="rollTrademark"><i class="fa-solid fa-dice"></i></button>
    </div>
  </div>
  <div class="form-group">
    <label>Conflict</label>
    <div class="form-fields up-down-buttons">
      <textarea rows="3" style="flex: 1" name="conflict">{{actor.conflict}}</textarea>
      <button type="button" data-action="rollConflict"><i class="fa-solid fa-dice"></i></button>
    </div>
  </div>
  <div class="footer">
    {{!-- <button type="button" data-action="movePrevious">Previous</button> --}}
    <button type="button" data-action="moveNext" {{ifThen data.basicInformation.ready "" "disabled" }}>Next</button>
  </div>
</section>