<div>
  <div class="grid">
    <div class="grid-span-2">
      <label>Attributes /</label>
    </div>
    {{> "systems/outside-the-wire/templates/partials/field.hbs" group="Attributes"
    fieldName=systemFields.attributes.fields.strength.name
    fieldPath="system.attributes.strength.value"
    value=system.attributes.strength}}
    {{> "systems/outside-the-wire/templates/partials/field.hbs" group="Attributes"
    fieldName=systemFields.attributes.fields.agility.name
    fieldPath="system.attributes.agility.value"
    value=system.attributes.agility}}
    {{> "systems/outside-the-wire/templates/partials/field.hbs" group="Attributes"
    fieldName=systemFields.attributes.fields.wisdom.name
    fieldPath="system.attributes.wisdom.value"
    value=system.attributes.wisdom}}
    {{> "systems/outside-the-wire/templates/partials/field.hbs" group="Attributes"
    fieldName=systemFields.attributes.fields.knowledge.name
    fieldPath="system.attributes.knowledge.value"
    value=system.attributes.knowledge}}
  </div>
  <div class="grid">
    {{> "systems/outside-the-wire/templates/partials/field.hbs" group="Actor.base.FIELDS"
    fieldName="combatExperience.label"
    fieldPath="system.combatExperience.value"
    no_roll=true
    value=system.combatExperience}}
